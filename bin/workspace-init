#!/bin/bash
# 워크스페이스 기본 구조를 만든다. 이미 있는 파일·폴더는 덮어쓰지 않는다.
#   workspace-init [--dry-run] [--scan <폴더> ...] [<워크스페이스 루트>]
# 루트를 생략하면 AGENT_WORKSPACE_ROOT 를 쓴다.
# 만드는 것: repository/ work/ arxiv/ log/, 루트 AGENTS.md(공통 지침 템플릿), work/orchestrator.md(루트 허브 템플릿)
# --scan: 그 폴더 바로 아래의 git 레포를 찾아 repository/ 로 들일 계획만 보여 준다(옮기지 않는다).
#         --scan 이 없으면 루트 바로 아래를 본다.
set -euo pipefail
PLUGIN=$(cd "$(dirname "$0")/.." && pwd -P)
die() { echo "오류: $*" >&2; exit 1; }

dry=0; scans=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    --scan) [ -n "${2:-}" ] || die "--scan 뒤에 폴더가 필요하다"; scans+=("$2"); shift 2 ;;
    -*) die "모르는 옵션: $1" ;;
    *) break ;;
  esac
done
root=${1:-${AGENT_WORKSPACE_ROOT:-}}
[ -n "$root" ] || die "사용법: workspace-init [--dry-run] [--scan <폴더> ...] <워크스페이스 루트>"
case "$root" in /*) ;; *) root="$PWD/$root" ;; esac
root=${root%/}
[ -e "$root" ] && [ ! -d "$root" ] && die "폴더가 아니다: $root"

echo "워크스페이스: $root"
[ -d "$root" ] || echo "- 폴더 생성"
for d in repository work arxiv log; do
  if [ -d "$root/$d" ]; then echo "- $d/: 있음"; else echo "- $d/: 만든다"; fi
done
for f in AGENTS.md work/orchestrator.md; do
  if [ -e "$root/$f" ]; then echo "- $f: 있음 (그대로 둔다)"; else echo "- $f: 템플릿으로 만든다"; fi
done

if [ "$dry" = 0 ]; then
  mkdir -p "$root"/{repository,work,arxiv,log}
  [ -e "$root/AGENTS.md" ] || cp "$PLUGIN/templates/AGENTS.md" "$root/AGENTS.md"
  [ -e "$root/work/orchestrator.md" ] || cp "$PLUGIN/templates/orchestrator.md" "$root/work/orchestrator.md"
fi

# 흩어진 레포 찾기: 들일 계획만 보여 준다.
[ ${#scans[@]} -eq 0 ] && scans=("$root")
found=0
pre=""; [ "${AGENT_WORKSPACE_ROOT:-}" = "$root" ] || pre="AGENT_WORKSPACE_ROOT=$root "
for s in "${scans[@]}"; do
  [ -d "$s" ] || { echo "참고: 찾을 폴더가 없다: $s" >&2; continue; }
  s=$(cd "$s" && pwd -P)
  for g in "$s"/*/.git; do
    [ -e "$g" ] || continue
    r=$(dirname "$g"); n=$(basename "$r")
    case "$r" in "$root"/repository/*|"$root"/work/*|"$root"/arxiv/*) continue ;; esac
    [ "$found" = 0 ] && { echo; echo "repository/ 밖의 git 레포 (옮기지 않았다. 들이려면 사용자 확인 뒤 아래 명령):"; }
    found=1
    if [ -f "$g" ]; then
      echo "- $r: 다른 레포의 워크트리라 들이지 않는다"
    elif [ -e "$root/repository/$n" ]; then
      echo "- $r: repository/$n 이 이미 있다. 다른 이름으로: ${pre}add-repo --from $r --name <새 이름>"
    else
      dirty=$(git -C "$r" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      wts=$(( $(git -C "$r" worktree list 2>/dev/null | wc -l) - 1 ))
      echo "- $r → repository/$n (미커밋 ${dirty}건, 연결된 워크트리 ${wts}개): ${pre}add-repo --from $r"
    fi
  done
done

echo
if [ "${AGENT_WORKSPACE_ROOT:-}" != "$root" ]; then
  echo "다음: AGENT_WORKSPACE_ROOT 를 이 경로로 설정한다(예: ~/.claude/settings.json 의 \"env\": {\"AGENT_WORKSPACE_ROOT\": \"$root\"}). 설정 뒤 새 세션부터 훅이 켜진다."
else
  echo "AGENT_WORKSPACE_ROOT 가 이미 이 경로다."
fi
[ "$dry" = 1 ] && echo "(dry-run: 아무것도 만들지 않았다)" || echo "완료"
