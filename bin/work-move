#!/bin/bash
# work를 다른 곳으로 옮긴다(묶기·이름 바꾸기). 워크트리 연결, AGENTS.md 링크, Claude 세션 폴더를 함께 옮긴다.
#   work-move [--dry-run] <work> <새 경로>
# 예: work-move hotfix-x checkout-revamp/hotfix-x
# 경로는 work/ 기준 상대 경로 또는 절대 경로.
set -euo pipefail
. "$(dirname "$0")/work-lib.sh"

dry=0
[ "${1:-}" = "--dry-run" ] && { dry=1; shift; }
[ $# -eq 2 ] || die "사용법: work-move [--dry-run] <work> <새 경로>"
src=$(work_abs "$1")
[ "$(work_of "$src")" = "$src" ] || die "work 폴더가 아니다: $src"
case "$2" in /*) dst=$2 ;; *) dst="$W/$2" ;; esac
case "$dst" in "$W"/*) ;; *) die "work/ 밖으로는 옮기지 않는다: $dst" ;; esac
case "$dst/" in "$src"/*) die "자기 안으로는 옮길 수 없다: $dst" ;; esac
[[ "$(basename "$dst")" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "이름은 영어 소문자 kebab-case여야 한다: $(basename "$dst")"

work_move "$src" "$dst" "$dry"
[ "$dry" = 1 ] && echo "(dry-run: 아무것도 옮기지 않았다)" || echo "완료"
